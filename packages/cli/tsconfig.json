{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@forge-ai/core": ["../core/src"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../core" }]
}
